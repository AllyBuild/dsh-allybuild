{
  "name": "@deepseek-ai/dsh-allybuild-progress-sync",
  "description": "AllyBuild-side push of task-session progress (turn/tool phases) over HTTP",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
